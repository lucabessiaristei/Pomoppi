<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Pomoppi.exe.manifest — Win32 application manifest.

  Shipped by Scripts/make-windows-app.js as an external side-by-side
  manifest next to Pomoppi.exe (not linker-embedded).

  - Common Controls v6 dependency: needed for SysTabControl32 and the other
    themed common controls used by the Settings window (Phase W6/W7).
  - Per-monitor-v2 DPI awareness: the widget is hand-drawn pixel art scaled
    by settings.scale, same reasoning as the macOS build not wanting the
    OS to do its own scaling on top.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="it.lucabessiaristei.pomoppi"
    version="1.0.0.0"
    processorArchitecture="*"
  />
  <description>Pomoppi</description>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>
</assembly>
